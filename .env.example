# PostgreSQL is authoritative for the catalog and admin jobs.
DATABASE_URL=postgresql://prophecy_app:change-me@127.0.0.1:5432/prophecy
REQUIRE_DATABASE=false

# Required to enable protected admin catalog routes. Never commit the real value.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional Redis optimization layer; catalog data must remain in PostgreSQL.
REDIS_URL=redis://127.0.0.1/

PORT=8080
RUST_LOG=info
